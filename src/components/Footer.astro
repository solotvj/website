---
import Wordmark from './Wordmark.astro';
import { legal, whatsappUrl, useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);
---

<footer>
  <div class="main">
    <Wordmark class="brand" />
    <address>
      <p>
        <span class="label">WhatsApp</span>
        <a href={whatsappUrl()} target="_blank" rel="noopener">{legal.whatsapp}</a>
      </p>
      <p>
        <span class="label">{t('email')}</span>
        <a href={`mailto:${legal.email}`}>{legal.email}</a>
      </p>
    </address>
  </div>

  <div class="legal small">
    <p lang={legal.noteLang}>{legal.note}</p>
    <p class="links">
      <a href={t('privacyPath')}>{t('privacyLink')}</a>
      <a href={t('termsPath')}>{t('termsLink')}</a>
      <a href="/baja" hreflang="es">{t('cancelLink')}</a>
      <a href="/baja#arrepentimiento" hreflang="es">{t('withdrawLink')}</a>
    </p>
    <!-- ARCA's Data Fiscal (form F960/NM), as ARCA issues it. The link redirects to https; the image is loaded over https. -->
    <a class="data-fiscal" href="http://qr.afip.gob.ar/?qr=zcNxLI9w2PbVkd5sgKuBAw,," target="_F960AFIPInfo" rel="noopener">
      <img src="https://www.afip.gob.ar/images/f960/DATAWEB.jpg" width="239" height="327" alt="Data Fiscal (ARCA)" loading="lazy" />
    </a>
  </div>
</footer>

<style>
  footer {
    box-sizing: border-box;
    width: 100%;
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 var(--space-6);
    color: var(--ink-muted);
  }

  .main,
  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-6);
    border-top: 1px solid var(--line);
  }

  .main {
    align-items: flex-start;
    padding: var(--space-10) 0;
  }

  /* :global because the span lives in Wordmark's scope. */
  .main :global(.brand) {
    font-size: 32px;
  }

  address {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6) var(--space-10);
    font-style: normal;
  }

  address p {
    display: grid;
    gap: var(--space-1);
  }

  address .label {
    color: var(--ink-subtle);
  }

  address a {
    color: var(--ink);
  }

  .legal {
    align-items: center;
    padding: var(--space-6) 0;
    color: var(--ink-subtle);
  }

  p {
    margin: 0;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .data-fiscal img {
    display: block;
    width: auto;
    height: 64px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
  }
</style>
