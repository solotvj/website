---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { langs, ui, useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  /** Link for each language; defaults to each language's home. */
  hrefs?: Record<Lang, string>;
}

const { lang, hrefs } = Astro.props;
const t = useTranslations(lang);
// With other links in the slot it's the site's navigation, not only the language switch.
const label = Astro.slots.has('default') ? undefined : t('langNav');
---

<nav class="langs label" aria-label={label}>
  <slot />
  {
    langs.map((l, i) => (
      <>
        {i > 0 && <span aria-hidden="true">/</span>}
        <a
          href={hrefs?.[l] ?? getRelativeLocaleUrl(l)}
          hreflang={ui[l].htmlLang}
          lang={ui[l].htmlLang}
          aria-label={ui[l].name}
          aria-current={l === lang ? 'page' : undefined}
        >
          {ui[l].code}
        </a>
      </>
    ))
  }
</nav>

<style>
  /* Centred in the 64px top bar; each link is a 44px touch target. */
  .langs {
    position: absolute;
    top: 10px;
    right: var(--space-4);
    display: flex;
    align-items: center;
    color: var(--ink-subtle);
  }

  /* :global so links passed in the slot (e.g. Precios) look the same. */
  .langs :global(a) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0 var(--space-2);
    box-sizing: border-box;
    color: var(--ink-subtle);
    text-decoration: none;
  }

  .langs :global(a:hover),
  .langs :global(a[aria-current='page']) {
    color: var(--ink);
  }

  /* A link before the languages sits apart from them. */
  .langs :global(.nav-extra) {
    margin-right: var(--space-4);
  }
</style>
