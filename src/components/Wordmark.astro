---
// Reproduces the design system's Wordmark (bundle.css .stv-wordmark) without React.
interface Props {
  as?: 'h1' | 'span';
  class?: string;
}

const { as: Tag = 'span', class: className } = Astro.props;
---

<Tag class:list={['stv-wordmark', className]}>Solotvj<span class="stv-wordmark-dot">.</span></Tag>

<style>
  /* bundle.css sets the type and the dot's colour; it leaves the size to the page. */
  .stv-wordmark {
    margin: 0;
    font-size: 72px;
  }
</style>
