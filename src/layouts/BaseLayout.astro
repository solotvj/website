---
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import tokens from '../../design-system/tokens.json';
import '../../design-system/tokens.css';
import '../../design-system/bundle.css';
import Footer from '../components/Footer.astro';
import { defaultLang, langs, ui, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  /** 404 page: own title, noindex, no canonical or alternates. */
  notFound?: boolean;
  title?: string;
  description?: string;
  /** Absolute URL of this page in each language; defaults to each language's home. */
  urls?: Record<Lang, string>;
}

const d = ui[Astro.props.lang];
const {
  lang,
  notFound = false,
  title = notFound ? d.notFoundTitle : d.title,
  description = d.description,
  urls = Object.fromEntries(langs.map((l) => [l, getAbsoluteLocaleUrl(l)])) as Record<Lang, string>,
} = Astro.props;
const base = import.meta.env.BASE_URL;
const background = tokens.color.tokens.find((t) => t.name === 'surface-000')!.value.dark;
---

<!doctype html>
<html lang={d.htmlLang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={background} />
    {
      notFound ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          <link rel="canonical" href={urls[lang]} />
          {langs.map((l) => <link rel="alternate" hreflang={ui[l].htmlLang} href={urls[l]} />)}
          <link rel="alternate" hreflang="x-default" href={urls[defaultLang]} />
        </>
      )
    }
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Solotvj" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={urls[lang]} />
    <meta property="og:locale" content={d.ogLocale} />
    <!-- Preview card for shared links (WhatsApp, Facebook); generated from og/template.html. -->
    <meta property="og:image" content={new URL(`og-${lang}.png`, Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={d.title} />
    <meta name="twitter:card" content="summary_large_image" />
    {langs.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={ui[l].ogLocale} />)}

    <!-- Fonts come from design-system/bundle.css (its @import); preconnect so they start early. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body>
    <slot />
    <Footer lang={lang} />
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }

  /* Browsers without dvh units. */
  @supports not (min-height: 100dvh) {
    body {
      min-height: 100vh;
    }
  }
</style>
