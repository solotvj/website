---
// Layout for Markdown legal pages (src/pages/*.md). Frontmatter: lang, title, description.
import BaseLayout from './BaseLayout.astro';
import LangNav from '../components/LangNav.astro';
import Wordmark from '../components/Wordmark.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { langs, ui, type Lang } from '../i18n';

const { lang, title, description } = Astro.props.frontmatter as { lang: Lang; title: string; description: string };
const hrefs = Object.fromEntries(langs.map((l) => [l, ui[l].privacyPath])) as Record<Lang, string>;
const urls = Object.fromEntries(langs.map((l) => [l, new URL(hrefs[l], Astro.site).href])) as Record<Lang, string>;
---

<BaseLayout lang={lang} title={`${title} · Solotvj`} description={description} urls={urls}>
  <header>
    <a href={getRelativeLocaleUrl(lang)} class="home" aria-label="Solotvj"><Wordmark /></a>
    <LangNav lang={lang} hrefs={hrefs} />
  </header>
  <main class="body prose">
    <slot />
  </main>
</BaseLayout>

<style>
  header {
    padding: var(--space-4) var(--space-6);
  }

  .home {
    display: inline-block;
    text-decoration: none;
  }

  .home :global(.stv-wordmark) {
    font-size: 32px;
  }

  main {
    box-sizing: border-box;
    flex: 1;
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
    padding: var(--space-10) var(--space-4) var(--space-16);
    color: var(--ink-muted);
  }

  /* Markdown output has no classes, so the type classes from tokens.css are mirrored on its elements. */
  .prose :global(h1) {
    margin: 0 0 var(--space-6);
    font-family: var(--font-display);
    font-size: clamp(44px, 6vw + 20px, 72px);
    line-height: 1;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  /* Sections separated by a hairline; the source's --- dividers are hidden to avoid doubling it. */
  .prose :global(h2) {
    margin: var(--space-16) 0 var(--space-4);
    padding-top: var(--space-10);
    border-top: 1px solid var(--line);
    font-size: 24px;
    line-height: 32px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .prose :global(h3) {
    margin: var(--space-10) 0 var(--space-2);
    font-size: 18px;
    line-height: 26px;
    font-weight: 500;
    color: var(--ink);
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 var(--space-4);
  }

  .prose :global(li) {
    margin-bottom: var(--space-2);
  }

  .prose :global(strong) {
    font-weight: 500;
    color: var(--ink);
  }

  .prose :global(a) {
    color: var(--accent);
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }

  .prose :global(hr) {
    display: none;
  }

  /* Legal notices quoted from the law: an inset panel, not a decorative quote. */
  .prose :global(blockquote) {
    margin: 0 0 var(--space-4);
    padding: var(--space-4) var(--space-6);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface-100);
  }

  .prose :global(blockquote p:last-child) {
    margin: 0;
  }

  /* Mirrors the design system's Table (bundle.css .stv-table); display:block lets it scroll sideways on narrow screens. */
  .prose :global(table) {
    display: block;
    overflow-x: auto;
    margin: 0 0 var(--space-6);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    border-collapse: collapse;
    background: var(--surface-100);
    font-size: 14px;
    line-height: 20px;
    color: var(--ink);
  }

  .prose :global(th) {
    padding: 10px var(--space-4);
    text-align: left;
    vertical-align: bottom;
    background: var(--surface-200);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
    border-bottom: 1px solid var(--line);
  }

  .prose :global(td) {
    padding: 12px var(--space-4);
    vertical-align: top;
    border-bottom: 1px solid var(--line);
    min-width: 140px;
  }

  .prose :global(tbody tr:last-child td) {
    border-bottom: 0;
  }

  .prose :global(em) {
    color: var(--ink-subtle);
  }
</style>
