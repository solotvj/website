---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Wordmark from '../../components/Wordmark.astro';
import Button from '../../components/Button.astro';
import LangNav from '../../components/LangNav.astro';
import { defaultLang, legal, getLangFromUrl, langs, useTranslations } from '../../i18n';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang: lang === defaultLang ? undefined : lang } }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout lang={lang}>
  <LangNav lang={lang} />

  <main>
    <Wordmark as="h1" class="hero" />
    <p class="body tagline">{t('tagline')}</p>
    <Button href={`mailto:${legal.email}`}>{t('cta')}</Button>
  </main>
</BaseLayout>

<style>
  main {
    box-sizing: border-box;
    flex: 1;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--space-6);
    padding: var(--space-16) var(--space-6);
    text-align: center;
  }

  /* 72px (display-xl) at 360px, growing to 160px on wide screens. :global because the h1 lives in Wordmark's scope. */
  main :global(.hero) {
    font-size: clamp(72px, 12vw + 24px, 160px);
  }

  .tagline {
    margin: 0;
    color: var(--ink-muted);
  }
</style>
