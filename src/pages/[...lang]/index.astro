---
// The studio's homepage: what Solotvj makes, shown working, then how it works.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Wordmark from '../../components/Wordmark.astro';
import LangNav from '../../components/LangNav.astro';
import '../../styles/loca.css';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { defaultLang, legal, getLangFromUrl, langs, useTranslations, whatsappUrl } from '../../i18n';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang: lang === defaultLang ? undefined : lang } }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const wa = whatsappUrl(t('stWaText'));
const waCustom = whatsappUrl(t('stWaCustom'));
const agent = getRelativeLocaleUrl(lang, 'asistente');
// The rental system's page and the calculator exist in Spanish only.
const rentals = '/alquileres';
// What we make: [name, one line, where it leads, opens outside the site].
const made: [string, string, string, boolean][] = [
  [t('stAgent'), t('stAgentLine'), agent, false],
  [t('stRent'), t('stRentLine'), rentals, false],
  [t('stCustom'), t('stCustomBody'), waCustom, true],
];
const promises = [1, 2, 3].map((n) => t(`stDo${n}` as 'stDo1'));
---

<BaseLayout lang={lang}>
  <div class="loca">
    <header class="loca-header">
      <div class="loca-wrap">
        <a class="loca-home" href={getRelativeLocaleUrl(lang)} aria-label="Solotvj"><Wordmark class="stv-on-bone" /></a>
        <LangNav lang={lang}>
          <a class="nav-link" href="/precios" hreflang="es">{t('navPricing')}</a>
          <a class="nav-link nav-cta nav-extra" href="#contacto">{t('navContact')}</a>
        </LangNav>
      </div>
    </header>

    <main>
      <div class="loca-wrap opening">
        <nav class="index" aria-label={t('stWhat')}>
          <p class="index-head loca-label">{t('stWhat')}</p>
          <ol>
            {
              made.map(([name, line, href, external], i) => (
                <li>
                  <a class:list={['entry', { yellow: i === 2 }]} href={href} {...(external ? { target: '_blank', rel: 'noopener' } : {})}>
                    <span class="entry-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                    <span class="entry-name">{name}</span>
                    <svg class="entry-go" viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" /></svg>
                    <span class="entry-line">{line}</span>
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>

        <section id="como" class="promises" aria-label={t('stNavHow')}>
          {
            promises.map((line, i) => {
              const Line = i === 0 ? 'h1' : 'h2';
              return (
                <div class="promise">
                  <Line class:list={['loca-display', { last: i === 2 }]}>{line}</Line>
                </div>
              );
            })
          }
        </section>
      </div>

      <section class="band blue" aria-labelledby="agent-title">
        <div class="loca-wrap stack split">
          <div class="split-copy">
            <h2 id="agent-title" class="loca-display">{t('heroTitle1')} {t('heroTitle2')} <em>{t('heroTitle3')}</em></h2>
            <p class="lede">{t('heroLede')}</p>
            <div class="actions">
              <a class="loca-btn loca-btn-ink loca-btn-on-blue" href={agent}>{t('stAgentCta')}</a>
              <a class="more" href="/precios#asistente" hreflang="es">{t('heroPricing')}</a>
            </div>
          </div>
          <section class="chat" aria-label={t('chatLabel')}>
            <header class="chat-head loca-label">
              <span>{t('chatTitle')}</span>
              <span class="chat-time">03:12</span>
            </header>
            <div class="chat-body">
              <p class="bubble bubble-in">{t('chat1')}</p>
              <p class="bubble bubble-out">{t('chat2')}</p>
            </div>
          </section>
        </div>
      </section>

      <section class="band yellow" aria-labelledby="rent-title">
        <div class="loca-wrap stack split">
          <div class="split-copy">
            <h2 id="rent-title" class="loca-display">{t('stRentTitle1')} <em>{t('stRentTitle2')}</em></h2>
            <p class="lede">{t('alsoBody')}</p>
            <a class="loca-btn loca-btn-blue" href={rentals} hreflang="es">{t('stRentCta')}</a>
          </div>
          <div class="shot-wrap">
            <a class="split-shot" href={rentals} hreflang="es" tabindex="-1">
              <picture>
                <source media="(max-width: 640px)" srcset="/alquileres/mostrador-movil.jpg" width="900" height="715" />
                <img src="/alquileres/mostrador.jpg" alt={t('stShotAlt')} width="1920" height="1200" loading="lazy" />
              </picture>
            </a>
          </div>
        </div>
      </section>

      <section id="contacto" class="band dark" aria-labelledby="contact-title">
        <div class="loca-wrap stack contact">
          <h2 id="contact-title" class="loca-display">{t('stContactTitle1')}<br /><em>{t('stContactTitle2')}</em></h2>
          <a class="number" href={wa} target="_blank" rel="noopener">{legal.whatsapp}</a>
          <p class="contact-body">{t('stContactBody')} <a href={`mailto:${legal.email}`}>{legal.email}</a>.</p>
          <a class="loca-btn loca-btn-blue loca-btn-on-dark" href={wa} target="_blank" rel="noopener">{t('ctaWhatsapp')}</a>
        </div>
      </section>
    </main>
  </div>
</BaseLayout>

<style>
  .loca ::selection {
    background: var(--highlight);
    color: var(--ink-on-bone);
  }

  /* LangNav sits in the bar here instead of floating over it; its links take bone's ink. */
  .loca-header :global(.langs) {
    position: static;
    flex-wrap: wrap;
  }

  .loca-header :global(.langs a) {
    color: var(--ink-on-bone-muted);
  }

  .loca-header :global(.langs a:hover),
  .loca-header :global(.langs a[aria-current='page']) {
    color: var(--ink-on-bone);
  }

  .loca-header :global(.langs) .nav-link {
    display: inline-flex;
    font: 500 15px/20px var(--font-sans);
    letter-spacing: normal;
    text-transform: none;
    margin-right: var(--space-4);
    color: var(--ink-on-bone);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .loca-header :global(.langs) .nav-extra {
    margin-right: var(--space-2);
  }

  .loca-header :global(.langs) .nav-cta {
    display: inline-flex;
    padding: 0 var(--space-4);
    background: var(--ink-on-bone);
    color: var(--bone);
    text-decoration: none;
  }

  @media (min-width: 640px) {
    .loca-header :global(.langs) .nav-extra {
      margin-right: var(--space-6);
    }
  }

  /* The opening: the three promises at full size, and what we make as an index card beside them. */
  .opening {
    display: grid;
    gap: var(--space-10);
    padding-block: var(--space-10) var(--space-24);
  }

  .index {
    align-self: start;
    background: var(--paper);
    border: var(--stroke);
    box-shadow: 8px 8px 0 var(--ink-on-bone);
    transform: rotate(1deg);
  }

  /* Below the two-column layout it stays a card on the bone, not a menu across the page. */
  @media (max-width: 999px) {
    .index {
      width: 100%;
      max-width: 480px;
    }
  }

  .index-head {
    margin: 0;
    padding: var(--space-3) var(--space-5);
    background: var(--ink-on-bone);
    color: var(--bone);
  }

  .index ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .index li + li {
    border-top: var(--stroke);
  }

  .entry {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
    padding: var(--space-5);
    text-decoration: none;
    transition: background-color 0.15s, color 0.15s;
  }

  .entry.yellow {
    background: var(--highlight);
  }

  /* On the yellow row the secondary text is ink, not grey. */
  .entry.yellow :is(.entry-n, .entry-line) {
    color: var(--ink-on-bone);
  }

  .loca .entry:hover,
  .loca .entry:focus-visible {
    background: var(--accent-fill);
    color: var(--on-accent);
  }

  .entry-n {
    font: 500 14px/20px var(--font-mono);
    color: var(--ink-on-bone-muted);
  }

  .entry-name {
    font: 400 36px/1 var(--font-display);
    letter-spacing: -0.02em;
  }

  .entry-go {
    align-self: center;
    color: var(--accent-fill);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .entry-line {
    grid-column: 2 / -1;
    font-size: 16px;
    line-height: 23px;
    color: var(--ink-on-bone-muted);
  }

  .entry:hover :is(.entry-n, .entry-line, .entry-go),
  .entry:focus-visible :is(.entry-n, .entry-line, .entry-go) {
    color: inherit;
  }

  .entry:hover .entry-go,
  .entry:focus-visible .entry-go {
    transform: translateX(6px);
  }

  .promise {
    padding-block: var(--space-4) var(--space-6);
    border-bottom: var(--stroke);
  }

  .promise:last-child {
    border-bottom: 0;
  }

  .promise .loca-display {
    font-size: clamp(40px, 13vw, 132px);
    line-height: 0.88;
  }

  .promise .last {
    font-style: italic;
    color: var(--accent-fill);
  }

  /* Full-width colour bands. */
  .band.dark {
    background: var(--ink-on-bone);
    color: var(--bone);
  }

  .band.blue {
    background: var(--accent-fill);
    color: var(--on-accent);
  }

  .band.blue :focus-visible {
    outline-color: var(--on-accent);
  }

  .band.yellow {
    background: var(--highlight);
    border-block: var(--stroke);
  }

  .band.blue .loca-display em {
    color: var(--highlight);
    white-space: nowrap;
  }

  .band.yellow .loca-display em {
    color: var(--accent-fill);
  }

  .band.dark .loca-display em {
    color: var(--accent);
  }

  .stack {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-10);
    padding-block: var(--space-32);
  }

  .stack p {
    margin: 0;
  }

  .lede {
    max-width: 46ch;
    font: 500 22px/32px var(--font-sans);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-6) var(--space-10);
  }

  .more {
    display: inline-block;
    padding-block: var(--space-2);
    font-weight: 600;
    text-underline-offset: 4px;
  }

  /* On the blue band the ink button's shadow turns yellow. */
  .loca .loca-btn-on-blue {
    box-shadow: 6px 6px 0 var(--highlight);
  }

  .loca .loca-btn-on-blue:hover {
    box-shadow: 2px 2px 0 var(--highlight);
  }

  .split {
    display: grid;
    align-items: center;
    gap: var(--space-16);
  }

  .split-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-10);
  }

  .split-shot {
    display: block;
    border: var(--stroke);
    box-shadow: 12px 12px 0 var(--ink-on-bone);
    transform: rotate(1.5deg);
  }

  .shot-wrap {
    display: grid;
    gap: var(--space-6);
    min-width: 0;
  }

  /* The assistant's example conversation, as on its own page. */
  .chat {
    width: 100%;
    max-width: 460px;
    justify-self: start;
    background: var(--paper);
    color: var(--ink-on-bone);
    border: var(--stroke);
    box-shadow: 12px 12px 0 var(--ink-on-bone);
    transform: rotate(2deg);
  }

  .chat-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-6);
    border-bottom: var(--stroke);
    font-size: 12px;
  }

  .chat-time {
    padding: 2px var(--space-2);
    background: var(--ink-on-bone);
    color: var(--bone);
  }

  .chat-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
  }

  .bubble {
    max-width: 88%;
    margin: 0;
    padding: 12px var(--space-4);
    border: var(--stroke);
    font-size: 17px;
    line-height: 24px;
  }

  .bubble-in {
    align-self: flex-start;
    background: var(--bone);
  }

  .bubble-out {
    align-self: flex-end;
    background: var(--accent-fill);
    color: var(--on-accent);
  }

  .split-shot img {
    display: block;
    width: 100%;
    height: auto;
  }

  .number {
    font: 400 clamp(40px, 7vw, 88px) / 1 var(--font-display);
    text-decoration: none;
  }

  .contact-body {
    max-width: 52ch;
    color: var(--ink-muted);
  }

  @media (min-width: 1000px) {
    .opening {
      grid-template-columns: minmax(0, 1fr) minmax(0, 440px);
      gap: var(--space-16);
      padding-top: var(--space-10);
    }

    .index {
      grid-column: 2;
      grid-row: 1;
      margin-top: var(--space-10);
      box-shadow: 12px 12px 0 var(--ink-on-bone);
      transform: rotate(1.5deg);
    }

    .promises {
      grid-column: 1;
      grid-row: 1;
    }

    .promise .loca-display {
      font-size: clamp(80px, 7.9vw, 114px);
    }
  }

  @media (min-width: 900px) {
    .split {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .chat {
      justify-self: center;
    }

    .split .loca-display {
      font-size: clamp(48px, 5.4vw, 80px);
    }
  }

  @media (max-width: 640px) {
    .stack {
      padding-block: var(--space-16);
    }

    .opening {
      padding-bottom: var(--space-16);
    }

    .entry-name {
      font-size: 30px;
    }

    .split-shot {
      box-shadow: 6px 6px 0 var(--ink-on-bone);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .entry,
    .entry-go {
      transition: none;
    }

    .entry:hover .entry-go,
    .entry:focus-visible .entry-go {
      transform: none;
    }
  }
</style>
