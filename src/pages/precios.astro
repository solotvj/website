---
// Client-facing pricing for both products, in pesos or dollars: the assistant (with a calculator for Meta's share) and the rental system.
import BaseLayout from '../layouts/BaseLayout.astro';
import Wordmark from '../components/Wordmark.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { whatsappUrl } from '../i18n';
import { pricing, rentals } from '../pricing';
import '../styles/loca.css';

// Spanish only: every language's alternate is this page, so its canonical isn't the homepage's.
const page = new URL('/precios', Astro.site).href;

// BCRA's official reference rate (Comunicación A 3500). Read at build time so the page works offline;
// the browser fetches it again so a visitor sees today's rate.
const BCRA = 'https://api.bcra.gob.ar/estadisticascambiarias/v1.0/Cotizaciones/USD';
let rate: { value: number; date: string } | null = null;
try {
  const r = await fetch(BCRA, { signal: AbortSignal.timeout(5000) });
  const day = (await r.json()).results[0];
  rate = { value: day.detalle[0].tipoCotizacion, date: day.fecha };
} catch {
  // Without a rate the page shows dollars only.
}

const presets = [100, 300, 600, 1500];
// One rate for every business: about 3 assistant replies per conversation.
const replies = 3;
const start = whatsappUrl('Hola, quiero empezar con el asistente de WhatsApp.');
const rentalsStart = whatsappUrl('Hola, quiero empezar con el sistema de alquileres.');
---

<BaseLayout
  lang="es"
  urls={{ es: page, en: page }}
  title="Precios · Solotvj"
  description="Cuánto pagás por mes: el asistente de WhatsApp, con lo que cobra Meta, y el sistema de alquileres, en pesos o en dólares."
>
  <div class="loca">
    <header class="loca-header">
      <div class="loca-wrap">
        <a class="loca-home" href={getRelativeLocaleUrl('es')} aria-label="Solotvj"><Wordmark class="stv-on-bone" /></a>
        <a class="back" href={getRelativeLocaleUrl('es')}><span aria-hidden="true">←</span> Volver al inicio</a>
      </div>
    </header>

    <main class="loca-wrap" data-pricing={JSON.stringify({ ...pricing, replies })} data-rate={JSON.stringify(rate)} data-bcra={BCRA}>
      <h1 class="title"><span>Cuánto pagás</span> <em>por mes.</em></h1>

      <div class="bar">
        <ul class="index">
          <li><a href="#asistente">Asistente de WhatsApp</a></li>
          <li><a href="#alquileres">Sistema de alquileres</a></li>
        </ul>
        <div class="currency" role="radiogroup" aria-label="Moneda" id="currency" hidden>
          <label><input type="radio" name="currency" value="ARS" /> Pesos</label>
          <label><input type="radio" name="currency" value="USD" checked /> Dólares</label>
        </div>
      </div>

      <section id="asistente" class="poster agent" aria-labelledby="agent-title">
        <h2 id="agent-title" class="name">Asistente de WhatsApp</h2>
        <p class="price"><output data-money={pricing.fee}>US$ {pricing.fee}</output><em> por mes.</em></p>
        <p class="lede">Más <output data-money={pricing.setup}>US$ {pricing.setup}</output> de configuración, una sola vez. Lo de Meta depende de cuánto te escriben:</p>
        <form id="calc" class="strip" novalidate aria-labelledby="q1">
          <p id="q1" class="strip-q">¿Cuántas conversaciones tenés por mes?</p>
          <div class="chips" role="group" aria-label="Valores frecuentes">
            {presets.map((n) => <button type="button" class="chip" data-convs={n}>{n.toLocaleString('es-AR')}</button>)}
          </div>
          <div class="other">
            <label for="convs">¿Otro número?</label>
            <input id="convs" type="number" inputmode="numeric" min="0" step="50" value="300" />
          </div>
          <dl class="sum" aria-live="polite">
            <div><dt>Abono, a nosotros</dt><dd><output data-money={pricing.fee}>–</output></dd></div>
            <div><dt>Respuestas por WhatsApp, a Meta</dt><dd><output id="meta">–</output></dd></div>
            <div class="sum-total"><dt>Por mes</dt><dd><output id="monthly">–</output></dd></div>
          </dl>
          <p class="note" id="meta-note"></p>
        </form>
        <a id="cta" class="loca-btn loca-btn-ink" href={start} target="_blank" rel="noopener">Escribinos por WhatsApp</a>
      </section>

      <section id="alquileres" class="poster rent" aria-labelledby="rent-title">
        <h2 id="rent-title" class="name">Sistema de alquileres</h2>
        <p class="price"><output data-money={rentals.fee}>US$ {rentals.fee}</output><em> por mes.</em></p>
        <p class="lede">Tu sitio de reservas, el stock, el mostrador, las señas con Mercado Pago y las facturas con ARCA, en un solo lugar.</p>
        <a class="loca-btn loca-btn-blue loca-btn-on-dark" href={rentalsStart} target="_blank" rel="noopener">Escribinos por WhatsApp</a>
      </section>

      <details class="how">
        <summary>
          Cómo se paga y cómo lo calculamos
          <svg class="chev" aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
        </summary>
        <ul>
          <li>Nuestros precios están en dólares y son finales: no sumamos IVA (somos monotributistas).</li>
          <li>
            Te facturamos en pesos, al tipo de cambio oficial del Banco Central (BCRA) del día hábil anterior a la
            factura.<span id="rate-line" hidden>{' '}Hoy: <output id="rate">–</output>, según el BCRA del <output id="rate-date">–</output>.</span>
          </li>
          <li>
            Asistente de WhatsApp: US$ {pricing.fee} por mes y US$ {pricing.setup} de configuración, una sola vez. Sistema
            de alquileres: US$ {rentals.fee} por mes.
          </li>
          <li>
            Calculamos unas {replies} respuestas del asistente por conversación. Meta no cobra las primeras
            {' '}{pricing.free.toLocaleString('es-AR')} respuestas de cada mes; lo que pase de ahí te lo factura Meta en pesos,
            con su propia tarifa, y acá es una estimación.
          </li>
        </ul>
      </details>
    </main>
  </div>
</BaseLayout>

<script>
  type Pricing = { setup: number; fee: number; metaRate: number; free: number; replies: number };
  const main = document.querySelector('main')!;
  const P = JSON.parse(main.dataset.pricing!) as Pricing;
  let rate = JSON.parse(main.dataset.rate!) as { value: number; date: string } | null;

  const $ = (id: string) => document.getElementById(id)!;
  const convs = $('convs') as HTMLInputElement;

  const int = (n: number) => Math.round(n).toLocaleString('es-AR');
  const currency = () => (rate ? (document.querySelector<HTMLInputElement>('input[name="currency"]:checked')?.value ?? 'USD') : 'USD');
  const money = (usd: number) =>
    currency() === 'ARS'
      ? (usd * rate!.value).toLocaleString('es-AR', { style: 'currency', currency: 'ARS', maximumFractionDigits: 0 })
      : usd.toLocaleString('es-AR', { style: 'currency', currency: 'USD', minimumFractionDigits: 0, maximumFractionDigits: 2 });
  const volume = () => Math.max(0, Number(convs.value) || 0);

  function render() {
    const c = volume();
    const meta = Math.max(0, c * P.replies - P.free) * P.metaRate;

    // Every price on the page, both products, in the chosen currency.
    document.querySelectorAll<HTMLOutputElement>('[data-money]').forEach((o) => (o.textContent = money(Number(o.dataset.money))));
    $('meta').textContent = money(meta);
    $('monthly').textContent = money(P.fee + meta);
    $('meta-note').textContent = meta
      ? `Meta te factura esa parte aparte, en pesos y con su propia tarifa: acá es una estimación. Las primeras ${int(P.free)} respuestas de cada mes son gratis.`
      : `Con este volumen, Meta no te cobra nada: las primeras ${int(P.free)} respuestas de cada mes son gratis.`;
    document.querySelectorAll<HTMLButtonElement>('[data-convs]').forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.convs) === c)));
    // The WhatsApp message carries what they calculated, so the conversation starts from their numbers.
    const cta = $('cta') as HTMLAnchorElement;
    const url = new URL(cta.href);
    url.searchParams.set('text', `Hola, quiero empezar con el asistente de WhatsApp. Calculé unas ${int(c)} conversaciones por mes.`);
    cta.href = url.href;
    if (rate) {
      $('rate').textContent = `US$ 1 = ${rate.value.toLocaleString('es-AR', { style: 'currency', currency: 'ARS', minimumFractionDigits: 2 })}`;
      $('rate-date').textContent = new Date(`${rate.date}T12:00:00`).toLocaleDateString('es-AR', { day: 'numeric', month: 'long', year: 'numeric' });
    }
    $('currency').hidden = $('rate-line').hidden = !rate;
  }

  document.querySelectorAll<HTMLButtonElement>('[data-convs]').forEach((b) =>
    b.addEventListener('click', () => {
      convs.value = b.dataset.convs!;
      render();
    }),
  );
  main.addEventListener('input', render);
  main.addEventListener('change', render);
  $('calc').addEventListener('submit', (e) => e.preventDefault());

  render();
  // Today's rate; the one from the build stays if the BCRA doesn't answer.
  fetch(main.dataset.bcra!, { signal: AbortSignal.timeout(5000) })
    .then((r) => r.json())
    .then((j) => {
      const day = j.results[0];
      rate = { value: day.detalle[0].tipoCotizacion, date: day.fecha };
      render();
    })
    .catch(() => {});
</script>

<style>
  /* The currency switch sets display, which would override `hidden`. */
  [hidden] {
    display: none !important;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    font-size: 15px;
    font-weight: 500;
  }

  main {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    max-width: 920px;
    padding-block: var(--space-16) 96px;
  }

  p,
  h2 {
    margin: 0;
  }

  .title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(64px, 11vw, 144px);
    line-height: 0.9;
    letter-spacing: -0.03em;
  }

  .title > * {
    display: block;
  }

  .title em {
    color: var(--accent-fill);
  }

  /* The two products, then Pesos / Dólares for both. */
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4) var(--space-6);
    margin-top: calc(-1 * var(--space-10));
  }

  .index {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .index a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
    text-underline-offset: 4px;
  }

  /* Pesos / Dólares: two joined blocks; the chosen one in ink. */
  .currency {
    display: flex;
  }

  .currency label {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 20px;
    border: var(--stroke);
    background: var(--paper);
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
  }

  .currency label + label {
    margin-left: -2px;
  }

  .currency input {
    position: absolute;
    opacity: 0;
  }

  .currency label:has(input:checked) {
    background: var(--ink-on-bone);
    color: var(--bone);
  }

  .currency label:has(input:focus-visible) {
    outline: 3px solid var(--accent-fill);
    outline-offset: 3px;
  }

  /* One poster per product: the price at full size, yellow for the assistant, black for rentals. */
  .poster {
    display: grid;
    gap: var(--space-6);
    padding: var(--space-16) clamp(16px, 4vw, 40px) var(--space-10);
    border: var(--stroke);
    box-shadow: 12px 12px 0 var(--ink-on-bone);
    scroll-margin-top: var(--space-6);
  }

  .agent {
    background: var(--highlight);
  }

  .rent {
    background: var(--ink-on-bone);
    color: var(--bone);
    box-shadow: 12px 12px 0 var(--accent-fill);
  }

  .name {
    font: 400 clamp(32px, 4vw, 48px) / 1 var(--font-display);
    letter-spacing: -0.02em;
  }

  /* Sized so a peso amount ("$ 153.549") still fits on one line at every width. */
  .price {
    font: 400 clamp(56px, 13vw, 200px) / 0.85 var(--font-display);
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }

  .price em {
    font-size: max(0.24em, 22px);
    letter-spacing: 0;
    color: var(--accent-fill);
  }

  .rent .price em {
    color: var(--accent);
  }

  .lede {
    max-width: 46ch;
    font: 500 20px / 30px var(--font-sans);
  }

  .poster .loca-btn {
    justify-self: start;
  }

  /* The assistant's calculator, on paper inside its poster. */
  .strip {
    display: grid;
    gap: var(--space-6);
    padding: var(--space-6) clamp(16px, 3vw, 24px);
    background: var(--paper);
    color: var(--ink-on-bone);
    border: var(--stroke);
  }

  .strip-q {
    font-weight: 600;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .chip {
    flex: 1 1 120px;
    min-height: 80px;
    padding: 0 var(--space-4);
    border: var(--stroke);
    background: var(--paper);
    color: var(--ink-on-bone);
    font-family: var(--font-display);
    font-size: 48px;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    cursor: pointer;
    transition: transform 0.12s, box-shadow 0.12s;
  }

  .chip:hover {
    transform: translate(-2px, -2px);
    box-shadow: 8px 8px 0 var(--ink-on-bone);
  }

  .chip[aria-pressed='true'] {
    background: var(--accent-fill);
    color: var(--on-accent);
    box-shadow: 6px 6px 0 var(--ink-on-bone);
  }

  .other {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    font-size: 16px;
    font-weight: 500;
  }

  .other input {
    width: 140px;
    box-sizing: border-box;
    min-height: 56px;
    padding: 0 var(--space-4);
    border: var(--stroke);
    border-radius: 0;
    background: var(--paper);
    color: var(--ink-on-bone);
    font: 600 22px var(--font-sans);
    -moz-appearance: textfield;
  }

  .sum {
    margin: 0;
  }

  .sum div {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-1) var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--line-on-bone);
  }

  .sum dt {
    color: var(--ink-on-bone-muted);
  }

  .sum dd {
    margin: 0;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .sum .sum-total {
    align-items: baseline;
    padding-top: var(--space-4);
    border-bottom: 0;
  }

  .sum .sum-total dt {
    color: var(--ink-on-bone);
    font-weight: 600;
  }

  .sum .sum-total dd {
    font: 400 44px / 1 var(--font-display);
    letter-spacing: -0.02em;
  }

  .note {
    font-size: 15px;
    line-height: 22px;
    color: var(--ink-on-bone-muted);
  }

  .how {
    border-block: var(--stroke);
  }

  .how summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 72px;
    font-size: 22px;
    line-height: 28px;
    font-weight: 600;
    list-style: none;
    cursor: pointer;
  }

  .how summary::-webkit-details-marker {
    display: none;
  }

  .chev {
    flex: none;
  }

  .how[open] .chev {
    transform: rotate(180deg);
  }

  .how ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0 0 var(--space-6);
    padding-left: 20px;
    font-size: 16px;
    line-height: 24px;
  }

  /* On a phone the four presets sit two by two instead of one per row. */
  @media (max-width: 559px) {
    .chip {
      flex-basis: calc(50% - var(--space-2));
      min-height: 72px;
      font-size: 40px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chip {
      transition: none;
    }
  }
</style>
