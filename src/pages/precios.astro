---
// Client-facing pricing: pick a volume, see our fees plus what Meta bills for the replies, in pesos or dollars.
import BaseLayout from '../layouts/BaseLayout.astro';
import Wordmark from '../components/Wordmark.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { whatsappUrl } from '../i18n';
import { pricing } from '../pricing';
import '../styles/loca.css';

// Spanish only: every language's alternate is this page, so its canonical isn't the homepage's.
const page = new URL('/precios', Astro.site).href;

// BCRA's official reference rate (Comunicación A 3500). Read at build time so the page works offline;
// the browser fetches it again so a visitor sees today's rate.
const BCRA = 'https://api.bcra.gob.ar/estadisticascambiarias/v1.0/Cotizaciones/USD';
let rate: { value: number; date: string } | null = null;
try {
  const r = await fetch(BCRA, { signal: AbortSignal.timeout(5000) });
  const day = (await r.json()).results[0];
  rate = { value: day.detalle[0].tipoCotizacion, date: day.fecha };
} catch {
  // Without a rate the page shows dollars only.
}

const presets = [100, 300, 600, 1500];
// One rate for every business: about 3 assistant replies per conversation.
const replies = 3;
const start = whatsappUrl('Hola, quiero empezar con el asistente de WhatsApp.');
---

<BaseLayout
  lang="es"
  urls={{ es: page, en: page }}
  title="Cuánto pagás por mes · Solotvj"
  description="Calculá lo que pagás por el asistente de WhatsApp: nuestro abono y lo que cobra Meta, en pesos o en dólares."
>
  <div class="loca">
    <header class="loca-header">
      <div class="loca-wrap">
        <a class="loca-home" href={getRelativeLocaleUrl('es')} aria-label="Solotvj"><Wordmark class="stv-on-bone" /></a>
        <a class="back" href={getRelativeLocaleUrl('es')}><span aria-hidden="true">←</span> Volver al inicio</a>
      </div>
    </header>

    <main class="loca-wrap" data-pricing={JSON.stringify({ ...pricing, replies })} data-rate={JSON.stringify(rate)} data-bcra={BCRA}>
      <h1 class="title">
        <span>Cuánto pagás</span>
        <em>por mes.</em>
      </h1>

      <form id="calc" class="calc" novalidate>
        <section class="question" aria-labelledby="q1">
          <div class="question-head">
            <p class="loca-label">Una sola pregunta</p>
            <h2 id="q1" class="question-title">¿Cuántas conversaciones tenés por mes?</h2>
            <p class="question-hint">
              Cada cliente que te escribe es una conversación. Si vuelve otro día, cuenta de nuevo. Si no sabés, elegí lo
              más parecido.
            </p>
          </div>
          <div class="chips" role="group" aria-label="Valores frecuentes">
            {presets.map((n) => <button type="button" class="chip" data-convs={n}>{n.toLocaleString('es-AR')}</button>)}
          </div>
          <div class="other">
            <label for="convs">¿Otro número?</label>
            <input id="convs" type="number" inputmode="numeric" min="0" step="50" value="300" />
          </div>
        </section>

        <section class="result-wrap" aria-labelledby="result-title" aria-live="polite">
          <div class="loca-sticker sticker" aria-hidden="true">{`Mitad de\nprecio\n×${pricing.introMonths} meses`}</div>
          <div class="result">
            <div class="result-head">
              <h2 id="result-title" class="loca-label">Tu precio, los primeros {pricing.introMonths} meses</h2>
              <div class="currency" role="radiogroup" aria-label="Moneda" id="currency" hidden>
                <label><input type="radio" name="currency" value="ARS" checked /> Pesos</label>
                <label><input type="radio" name="currency" value="USD" /> Dólares</label>
              </div>
            </div>

            <div class="figures">
              <p class="total-row">
                <output class="total" id="monthly-intro">–</output>
                <span class="per">por mes</span>
              </p>
              <p class="after">
                <span>Después: <output id="monthly-after">–</output> por mes.</span>
                <span class="muted" id="per-day"></span>
              </p>
            </div>

            <table class="breakdown">
              <caption class="visually-hidden">Qué pagás, a quién y cada cuánto</caption>
              <tbody>
                <tr>
                  <th scope="row"><span class="key" aria-hidden="true"></span>Abono desde el mes {pricing.introMonths + 1}, a nosotros</th>
                  <td><output class="strong" data-money={pricing.fee}>–</output> por mes</td>
                </tr>
                <tr>
                  <th scope="row"><span class="key" aria-hidden="true"></span>Configuración, una sola vez, a nosotros</th>
                  <td><output class="strong" data-money={pricing.setup}>–</output></td>
                </tr>
                <tr class="meta-row">
                  <th scope="row"><span class="key" aria-hidden="true"></span>Respuestas por WhatsApp, a Meta</th>
                  <td><output class="strong" id="meta">–</output> por mes</td>
                </tr>
              </tbody>
            </table>
            <p class="note" id="meta-note"></p>

            <div class="start">
              <a id="cta" class="loca-btn loca-btn-ink" href={start} target="_blank" rel="noopener">Escribinos por WhatsApp</a>
              <span class="note">Sin compromiso: podés darte de baja cuando quieras.</span>
            </div>
          </div>
        </section>
      </form>

      <details class="how">
        <summary>
          Cómo se paga y cómo lo calculamos
          <svg class="chev" aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
        </summary>
        <ul>
          <li>Nuestros precios están en dólares y son finales: no sumamos IVA (somos monotributistas).</li>
          <li>
            Te facturamos en pesos, al tipo de cambio oficial del Banco Central (BCRA) del día hábil anterior a la
            factura.<span id="rate-line" hidden>{' '}Hoy: <output id="rate">–</output>, según el BCRA del <output id="rate-date">–</output>.</span>
          </li>
          <li>
            Abono: US$ {pricing.fee} por mes, US$ {pricing.intro} los primeros {pricing.introMonths} meses. Configuración:
            US$ {pricing.setup}, una sola vez.
          </li>
          <li>
            Calculamos unas {replies} respuestas del asistente por conversación. Meta no cobra las primeras
            {' '}{pricing.free.toLocaleString('es-AR')} respuestas de cada mes; lo que pase de ahí te lo factura Meta en pesos,
            con su propia tarifa, y acá es una estimación.
          </li>
        </ul>
      </details>
    </main>
  </div>
</BaseLayout>

<script>
  type Pricing = { setup: number; intro: number; fee: number; metaRate: number; free: number; replies: number };
  const main = document.querySelector('main')!;
  const P = JSON.parse(main.dataset.pricing!) as Pricing;
  let rate = JSON.parse(main.dataset.rate!) as { value: number; date: string } | null;

  const form = document.getElementById('calc') as HTMLFormElement;
  const $ = (id: string) => document.getElementById(id)!;
  const convs = $('convs') as HTMLInputElement;

  const int = (n: number) => Math.round(n).toLocaleString('es-AR');
  const currency = () => (rate ? (form.elements.namedItem('currency') as RadioNodeList).value : 'USD');
  const money = (usd: number) =>
    currency() === 'ARS'
      ? (usd * rate!.value).toLocaleString('es-AR', { style: 'currency', currency: 'ARS', maximumFractionDigits: 0 })
      : usd.toLocaleString('es-AR', { style: 'currency', currency: 'USD', minimumFractionDigits: 0, maximumFractionDigits: 2 });
  const volume = () => Math.max(0, Number(convs.value) || 0);

  function render() {
    const c = volume();
    const meta = Math.max(0, c * P.replies - P.free) * P.metaRate;
    const intro = P.intro + meta;

    document.querySelectorAll<HTMLOutputElement>('[data-money]').forEach((o) => (o.textContent = money(Number(o.dataset.money))));
    $('meta').textContent = money(meta);
    $('monthly-intro').textContent = money(intro);
    $('monthly-after').textContent = money(P.fee + meta);
    $('per-day').textContent = `Hoy son unos ${money(intro / 30)} por día.`;
    $('meta-note').textContent = meta
      ? `Meta te factura esa parte aparte, en pesos y con su propia tarifa: acá es una estimación. Las primeras ${int(P.free)} respuestas de cada mes son gratis.`
      : `Con este volumen, Meta no te cobra nada: las primeras ${int(P.free)} respuestas de cada mes son gratis.`;
    document.querySelectorAll<HTMLButtonElement>('[data-convs]').forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.convs) === c)));
    // The WhatsApp message carries what they calculated, so the conversation starts from their numbers.
    const cta = $('cta') as HTMLAnchorElement;
    const url = new URL(cta.href);
    url.searchParams.set('text', `Hola, quiero empezar con el asistente de WhatsApp. Calculé unas ${int(c)} conversaciones por mes.`);
    cta.href = url.href;
    if (rate) {
      $('rate').textContent = `US$ 1 = ${rate.value.toLocaleString('es-AR', { style: 'currency', currency: 'ARS', minimumFractionDigits: 2 })}`;
      $('rate-date').textContent = new Date(`${rate.date}T12:00:00`).toLocaleDateString('es-AR', { day: 'numeric', month: 'long', year: 'numeric' });
    }
    $('currency').hidden = $('rate-line').hidden = !rate;
  }

  document.querySelectorAll<HTMLButtonElement>('[data-convs]').forEach((b) =>
    b.addEventListener('click', () => {
      convs.value = b.dataset.convs!;
      render();
    }),
  );
  form.addEventListener('input', render);
  form.addEventListener('change', render);
  form.addEventListener('submit', (e) => e.preventDefault());

  render();
  // Today's rate; the one from the build stays if the BCRA doesn't answer.
  fetch(main.dataset.bcra!, { signal: AbortSignal.timeout(5000) })
    .then((r) => r.json())
    .then((j) => {
      const day = j.results[0];
      rate = { value: day.detalle[0].tipoCotizacion, date: day.fecha };
      render();
    })
    .catch(() => {});
</script>

<style>
  /* The currency switch sets display, which would override `hidden`. */
  [hidden] {
    display: none !important;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    font-size: 15px;
    font-weight: 500;
  }

  main {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    max-width: 920px;
    padding-block: var(--space-16) 96px;
  }

  p,
  h2 {
    margin: 0;
  }

  .muted,
  .question-hint {
    color: var(--ink-on-bone-muted);
  }

  .strong {
    font-weight: 700;
  }

  .title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(64px, 11vw, 144px);
    line-height: 0.9;
    letter-spacing: -0.03em;
  }

  .title > * {
    display: block;
  }

  .title em {
    color: var(--accent-fill);
  }

  .calc {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  .question {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .question-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .question-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(36px, 5vw, 56px);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .question-hint {
    max-width: 620px;
    font-size: 16px;
    line-height: 24px;
  }

  /* Presets as big blocks; the chosen one turns blue and lifts. */
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .chip {
    flex: 1 1 140px;
    min-height: 96px;
    padding: 0 var(--space-4);
    border: var(--stroke);
    background: var(--paper);
    color: var(--ink-on-bone);
    font-family: var(--font-display);
    font-size: 56px;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    cursor: pointer;
    transition: transform 0.12s, box-shadow 0.12s;
  }

  .chip:hover {
    transform: translate(-2px, -2px);
    box-shadow: 8px 8px 0 var(--ink-on-bone);
  }

  .chip[aria-pressed='true'] {
    background: var(--accent-fill);
    color: var(--on-accent);
    box-shadow: 6px 6px 0 var(--ink-on-bone);
  }

  .other {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    font-size: 16px;
    font-weight: 500;
  }

  .other input {
    width: 140px;
    box-sizing: border-box;
    min-height: 56px;
    padding: 0 var(--space-4);
    border: var(--stroke);
    border-radius: 0;
    background: var(--paper);
    color: var(--ink-on-bone);
    font: 600 22px var(--font-sans);
    -moz-appearance: textfield;
  }

  .result-wrap {
    position: relative;
  }

  .sticker {
    top: -56px;
    right: -8px;
    background: var(--accent-fill);
    color: var(--on-accent);
  }

  .result {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding: clamp(24px, 5vw, 48px);
    background: var(--highlight);
    border: var(--stroke);
    box-shadow: 12px 12px 0 var(--ink-on-bone);
  }

  /* Room on the right for the sticker, which overlaps the card's corner. */
  .result-head {
    padding-right: 104px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  /* Pesos / Dólares: two joined blocks; the chosen one in ink. */
  .currency {
    display: flex;
  }

  .currency label {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 20px;
    border: var(--stroke);
    background: var(--paper);
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
  }

  .currency label + label {
    margin-left: -2px;
  }

  .currency input {
    position: absolute;
    opacity: 0;
  }

  .currency label:has(input:checked) {
    background: var(--ink-on-bone);
    color: var(--bone);
  }

  .currency label:has(input:focus-visible) {
    outline: 3px solid var(--accent-fill);
    outline-offset: 3px;
  }

  .figures {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .total-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--space-6);
  }

  .total {
    font-family: var(--font-display);
    font-size: clamp(72px, 14vw, 176px);
    line-height: 0.95;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }

  .per {
    font-size: 22px;
    font-weight: 600;
  }

  .after {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
    font-size: 18px;
    line-height: 26px;
  }

  .breakdown {
    width: 100%;
    border-collapse: collapse;
    background: var(--paper);
    border: var(--stroke);
    font-size: 17px;
    line-height: 24px;
  }

  .breakdown th,
  .breakdown td {
    padding: var(--space-4) 20px;
    border-bottom: var(--stroke);
    font-variant-numeric: tabular-nums;
    vertical-align: middle;
  }

  .breakdown th {
    font-weight: 400;
    text-align: left;
  }

  .breakdown td {
    padding-left: var(--space-4);
    text-align: right;
    white-space: nowrap;
  }

  .meta-row > * {
    border-bottom: 0 !important;
    background: var(--accent-fill);
    color: var(--on-accent);
  }

  /* Square keys: ours in ink, Meta's in white on its blue row. */
  .key {
    display: inline-block;
    width: 14px;
    height: 14px;
    margin-right: 12px;
    background: var(--ink-on-bone);
    vertical-align: -1px;
  }

  .meta-row .key {
    background: var(--paper);
  }

  .note {
    font-size: 15px;
    line-height: 22px;
  }

  .start {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
  }

  .how {
    border-block: var(--stroke);
  }

  .how summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 72px;
    font-size: 22px;
    line-height: 28px;
    font-weight: 600;
    list-style: none;
    cursor: pointer;
  }

  .how summary::-webkit-details-marker {
    display: none;
  }

  .chev {
    flex: none;
  }

  .how[open] .chev {
    transform: rotate(180deg);
  }

  .how ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0 0 var(--space-6);
    padding-left: 20px;
    font-size: 16px;
    line-height: 24px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* On a phone the sticker stays inside the screen: rotated, it reaches ~15px past its box. */
  @media (max-width: 639px) {
    .sticker {
      right: 0;
    }
  }

  /* On a phone the breakdown's label and amount stack, so long amounts never squeeze the label. */
  @media (max-width: 559px) {
    .breakdown tr {
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
      padding: var(--space-4) 20px;
      border-bottom: var(--stroke);
    }

    .breakdown .meta-row {
      border-bottom: 0;
      background: var(--accent-fill);
    }

    .breakdown th,
    .breakdown td {
      padding: 0;
      border: 0;
      text-align: left;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chip {
      transition: none;
    }
  }
</style>
